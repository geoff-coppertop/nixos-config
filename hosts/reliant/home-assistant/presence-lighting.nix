# Home Assistant automation for reliant: presence-driven room lighting.
#
# Turns a room's lights on while its presence sensor detects someone, off
# `linger` after presence clears. One desired-state automation per room,
# generated by mkPresenceLighting from just the room's presence/lights
# entities — add a room by adding an entry to the list at the bottom.
#
# Restart-resilient: alongside the presence on/off edges, a `homeassistant`
# start trigger re-derives desired state (on iff presence is currently
# detected), so a reboot restores correct state instead of waiting for the
# next presence edge. `linger` itself is not persisted across a restart.
#
# `presence` just needs to be a binary_sensor.* reporting on/off; the
# automation doesn't care whether "off" means true occupancy-sensing cleared
# or a motion sensor's own hardware timer expired. Two kinds are in use here:
# Aqara FP1e mmWave (via Matter) clears almost immediately once the room is
# empty, so `linger` is effectively the whole "stay lit after leaving" delay;
# Zigbee PIR motion (via Zigbee2MQTT) clears only after its own internal
# occupancy timeout (~60-120s), so the real dark-delay is that timeout *plus*
# `linger` — use a shorter `linger` for these to avoid stacking overshoot.
#
# Lights may be light.* or switch.*; the turn on/off service is derived from
# the entity's own domain.
#
# The optional `door` parameter (a door/window contact sensor) adds opening
# the door as an extra instant-on trigger, useful since a motion sensor's own
# occupancy timeout may not cover the first second of someone entering. It
# does NOT gate the off side the same way: motion alone decides on. For off,
# it shortens the wait — presence clear plus the door closed, together, for
# `doorClosedLinger` turns lights off quickly (person left and shut the
# door), while the plain `presence -> off, for = linger` trigger remains the
# fallback that fires regardless of door state, so a propped-open door
# doesn't keep lights on forever.
#
# That "regardless of door state" guarantee is why the action dispatches on
# *which trigger fired* rather than re-checking current presence/door state:
# if the off-side re-evaluated "is presence or door currently on" the way
# on-side triggers do, a door left open would read true right as
# linger/doorClosedLinger fires, turning lights back on instead of off. Only
# the `homeassistant` start trigger falls through to a current-state check,
# to restore correct state after a reboot.
#
# "automation manual" key, not bare "automation" — see default.nix.
{lib, ...}: {
  services.home-assistant.config."automation manual" = let
    # Build one restart-resilient desired-state automation for a room from just
    # its presence sensor and lights entity. `slug` is the entity-safe id stem;
    # `linger` is how long the lights stay on after presence clears. The turn
    # on/off service is taken from the lights entity's domain, so `lights` may
    # be a light.* or switch.* (or any domain exposing turn_on/turn_off).
    mkPresenceLighting = {
      room,
      slug,
      presence,
      lights,
      door ? null,
      linger ? "00:05:00",
      doorClosedLinger ? "00:01:00",
    }: let
      domain = builtins.head (lib.splitString "." lights);
      onCondition =
        if door == null
        then {
          condition = "state";
          entity_id = presence;
          state = "on";
        }
        else {
          condition = "or";
          conditions = [
            {
              condition = "state";
              entity_id = presence;
              state = "on";
            }
            {
              condition = "state";
              entity_id = door;
              state = "on";
            }
          ];
        };
      onTriggerIds = ["presence_on"] ++ lib.optional (door != null) "door_on";
      offTriggerIds = ["presence_off_linger"] ++ lib.optional (door != null) "door_closed_linger";
    in {
      id = "presence_lighting_${slug}";
      alias = "${room}: lights follow presence";
      description = "Turn on ${room}'s lights while presence is detected${lib.optionalString (door != null) " or the door is open"} and off ${
        if door == null
        then "${linger} after presence clears"
        else "${doorClosedLinger} after presence clears and the door is closed, or after ${linger} regardless of door state"
      }. Re-evaluated on presence edges${lib.optionalString (door != null) ", the door opening or closing,"} and on Home Assistant startup.";
      mode = "single";
      trigger =
        [
          # Presence detected -> lights should be on.
          {
            id = "presence_on";
            platform = "state";
            entity_id = presence;
            to = "on";
          }
          # Presence has been clear for the full linger window -> lights off,
          # forced by trigger id below regardless of current door state. For
          # a room with `door` set, this is the max/fallback wait; the
          # shorter door-aware trigger below usually fires first.
          {
            id = "presence_off_linger";
            platform = "state";
            entity_id = presence;
            to = "off";
            for = linger;
          }
          # Restore the correct state after a reboot or config reload.
          {
            id = "startup";
            platform = "homeassistant";
            event = "start";
          }
        ]
        ++ lib.optional (door != null) {
          # Door opened -> instant on, independent of motion. Does not gate
          # the off side; see the header comment.
          id = "door_on";
          platform = "state";
          entity_id = door;
          to = "on";
        }
        ++ lib.optional (door != null) {
          # Presence clear and the door (also) closed, continuously, for the
          # shorter doorClosedLinger -> lights off sooner than the plain
          # linger fallback above (person left and shut the door).
          id = "door_closed_linger";
          platform = "template";
          value_template = "{{ is_state('${presence}', 'off') and is_state('${door}', 'off') }}";
          for = doorClosedLinger;
        };
      action = [
        {
          choose = [
            {
              # An on-edge trigger fired (presence detected, or the door
              # just opened) -> lights on, unconditionally.
              conditions = [
                {
                  condition = "trigger";
                  id = onTriggerIds;
                }
              ];
              sequence = [
                {
                  service = "${domain}.turn_on";
                  target.entity_id = lights;
                }
              ];
            }
            {
              # An off-edge trigger fired (linger or doorClosedLinger
              # elapsed) -> lights off, unconditionally. Must not re-check
              # current door/presence state here: for a propped-open door,
              # the door is still "on" right as this fires, which would
              # otherwise send this to the on-branch below and the lights
              # would never turn off.
              conditions = [
                {
                  condition = "trigger";
                  id = offTriggerIds;
                }
              ];
              sequence = [
                {
                  service = "${domain}.turn_off";
                  target.entity_id = lights;
                }
              ];
            }
            {
              # Neither edge trigger -> this is the startup trigger;
              # re-derive desired state from current presence/door state.
              conditions = [onCondition];
              sequence = [
                {
                  service = "${domain}.turn_on";
                  target.entity_id = lights;
                }
              ];
            }
          ];
          # Startup with the room empty (and door closed, when set) -> off.
          default = [
            {
              service = "${domain}.turn_off";
              target.entity_id = lights;
            }
          ];
        }
      ];
    };
  in
    map mkPresenceLighting [
      {
        room = "Geoff's Office";
        slug = "geoffs_office";
        presence = "binary_sensor.geoff_s_office_presence_occupancy";
        lights = "light.geoff_s_office_lights";
      }
      {
        room = "Utility Room";
        slug = "utility_room";
        presence = "binary_sensor.motion_sensor_utility_room_occupancy";
        lights = "switch.utility_room";
        door = "binary_sensor.utility_room_parasoll_contact";
        doorClosedLinger = "00:01:00";
      }
    ];
}
