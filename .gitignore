# Encrypted agenix secrets are committed to git.

# Never keep plaintext scratch files or recovery key material under secrets/.
secrets/**/*.bak
secrets/**/*.dec
secrets/**/*.decrypted
secrets/**/*.plaintext
secrets/**/*.raw
secrets/**/*.tmp
secrets/**/identity
secrets/**/keys.txt
secrets/**/*.agekey

*.patch

# nix build output symlinks
result
result-*

# Claude Code agent-isolation worktrees (nested under .claude/ when created
# from inside this repo rather than as a sibling directory).
.claude/worktrees/

# Claude Code local state — machine-specific, not shared
.claude/settings.local.json
